# ScanGuru Portal API — environment template
# Copy to .env and fill in real values for local development.

# JWT signing key — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-32-byte-hex

# Fernet PHI encryption key — generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: losing this key makes encrypted patient PHI unrecoverable.
# Back it up in a password manager or KMS.
PHI_ENCRYPTION_KEY=replace-with-fernet-key

# Postgres connection (local dev default below)
DATABASE_URL=postgresql+psycopg2://portal:portal@localhost:5432/scanguru_portal

# AI inference service — existing MedScan-AI Railway deployment
AI_SERVICE_URL=https://adorable-simplicity-production.up.railway.app

# Storage backend: local | firebase | s3
# Production MUST NOT use 'local' (Railway wipes filesystem on redeploy)
STORAGE_BACKEND=local

# For STORAGE_BACKEND=firebase, also set:
# FIREBASE_CREDENTIALS_JSON=<the service-account JSON contents>
# FIREBASE_STORAGE_BUCKET=<bucket>.appspot.com

# CORS — comma-separated origins allowed to call this API
CORS_ALLOW_ORIGINS=http://localhost:3000,https://scanguru.net

# Environment: dev | staging | prod
# 'prod' disables /docs and /openapi.json
ENV=dev
